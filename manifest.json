{
  "manifest_version": 3,
  "name": "EnhancedChrome",
  "version": "1.1.3",
  "icons": {
    "128": "icons/surveys.png"
  },
  "description": "书签标签、壁纸新标签页和当前窗口网页去重，设置集中管理。",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "webNavigation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开EnhancedChrome",
    "default_icon": "icons/surveys.png"
  },
  "options_page": "manager.html?settings=1",
  "chrome_url_overrides": {
    "newtab": "wallpaper/newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "dedupe/content-script.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  }
}
